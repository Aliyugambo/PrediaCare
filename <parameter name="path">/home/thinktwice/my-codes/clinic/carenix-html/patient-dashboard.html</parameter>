  <script>
    var API_BASE = 'http://localhost:5000/api';
    var currentUser = null;
    
    function switchTab(tabName) {
      document.querySelectorAll('.tab-btn').forEach(function(btn) {
        btn.classList.remove('active');
        if (btn.getAttribute('data-tab') === tabName) btn.classList.add('active');
      });
      document.querySelectorAll('.tab-pane').forEach(function(pane) {
        pane.classList.remove('active');
      });
      document.getElementById(tabName).classList.add('active');
      loadTabData(tabName);
    }
    
    function loadTabData(tabName) {
      if (tabName === 'appointments') loadAppointments();
      else if (tabName === 'medications') loadMedications();
      else if (tabName === 'records') loadRecords();
      else if (tabName === 'vitals') loadVitals();
    }
    
    function apiCall(endpoint, options) {
      options = options || {};
      return fetch(API_BASE + endpoint, {
        method: options.method || 'GET',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: options.body ? JSON.stringify(options.body) : undefined
      }).then(function(response) { return response.json(); });
    }
    
    function checkAuth() {
      apiCall('/auth/user').then(function(data) {
        currentUser = data.user;
        updateUserUI();
        loadDashboardData();
      }).catch(function() {
        currentUser = { id: 1, name: 'John Doe', email: 'john@example.com', role: 'patient' };
        updateUserUI();
        loadDashboardData();
      });
    }
    
    function updateUserUI() {
      var initials = currentUser.name.split(' ').map(function(n) { return n[0]; }).join('').toUpperCase();
      document.getElementById('headerAvatar').textContent = initials;
      document.getElementById('sidebarAvatar').textContent = initials;
      document.getElementById('dropdownName').textContent = currentUser.name;
      document.getElementById('dropdownEmail').textContent = currentUser.email;
      document.getElementById('sidebarName').textContent = currentUser.name;
      document.getElementById('welcomeTitle').textContent = 'Welcome back, ' + currentUser.name.split(' ')[0];
    }
    
    function loadDashboardData() {
      Promise.all([loadNextAppointment(), loadMedicationsSummary(), loadRecentResults(), loadHealthSummary()]).catch(function() { setDemoData(); });
    }
    
    function loadNextAppointment() {
      return apiCall('/appointments/next').then(function(data) {
        if (data.hasAppointment) {
          var apt = data.appointment;
          var d = new Date(apt.date);
          var today = new Date();
          var tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate() + 1);
          var dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          if (d.toDateString() === today.toDateString()) dateStr = 'Today';
          else if (d.toDateString() === tomorrow.toDateString()) dateStr = 'Tomorrow';
          document.getElementById('nextAppointmentDate').textContent = dateStr;
          document.getElementById('nextAppointmentDetails').textContent = apt.time + ' with ' + apt.doctor.name;
          document.getElementById('aptBadge').textContent = apt.status;
        } else {
          document.getElementById('nextAppointmentDate').textContent = 'None';
          document.getElementById('nextAppointmentDetails').textContent = 'No upcoming appointments';
        }
      }).catch(function() {
        document.getElementById('nextAppointmentDate').textContent = 'Tomorrow';
        document.getElementById('nextAppointmentDetails').textContent = '10:30 AM with Dr. Johnson';
        document.getElementById('aptBadge').textContent = 'Confirmed';
      });
    }
    
    function loadMedicationsSummary() {
      return apiCall('/medications/summary/stats').then(function(data) {
        document.getElementById('medicationsCount').textContent = data.summary.active + ' Active';
        document.getElementById('medicationsNextDose').textContent = data.summary.expiringSoon > 0 ? data.summary.expiringSoon + ' expiring soon' : 'All up to date';
        document.getElementById('medBadge').textContent = data.summary.active + ' active';
      }).catch(function() {
        document.getElementById('medicationsCount').textContent = '3 Active';
        document.getElementById('medicationsNextDose').textContent = 'Next dose in 2 hours';
        document.getElementById('medBadge').textContent = '3 active';
      });
    }
    
    function loadRecentResults() {
      return apiCall('/results/recent/latest?limit=5').then(function(data) {
        document.getElementById('resultsCount').textContent = (data.unreadCount || data.count) + ' New';
        document.getElementById('resultsBadge').textContent = data.unreadCount + ' unread';
        if (data.results && data.results.length > 0) {
          var latest = data.results[0];
          var date = new Date(latest.resultDate).toLocaleDateString('en-US', { month: 'numeric', day: 'numeric' });
          document.getElementById('resultsLatest').textContent = latest.testName + ' from ' + date;
        }
      }).catch(function() {
        document.getElementById('resultsCount').textContent = '2 New';
        document.getElementById('resultsLatest').textContent = 'Blood work from 05/12';
        document.getElementById('resultsBadge').textContent = '2 unread';
      });
    }
    
    function loadHealthSummary() {
      return apiCall('/health-summary/latest').then(function(data) {
        if (data.hasSummary && data.summary.vitalSigns) {
          var vitals = JSON.parse(data.summary.vitalSigns);
          if (vitals.heartRate) document.getElementById('heartRate').textContent = vitals.heartRate + ' BPM';
          if (vitals.bloodPressure) document.getElementById('bloodPressure').textContent = vitals.bloodPressure;
          if (vitals.weight) document.getElementById('weight').textContent = vitals.weight + ' kg';
          if (vitals.temperature) { document.getElementById('temperature').textContent = vitals.temperature + '°F'; document.getElementById('temperatureMetric').style.display = 'flex'; }
          if (vitals.oxygen) { document.getElementById('oxygen').textContent = vitals.oxygen + '%'; document.getElementById('oxygenMetric').style.display = 'flex'; }
        }
        loadUpcomingAppointments();
      }).catch(function() {
        document.getElementById('heartRate').textContent = '72 BPM';
        document.getElementById('bloodPressure').textContent = '120/80';
        document.getElementById('weight').textContent = '68 kg';
        loadUpcomingAppointments();
      });
    }
    
    function loadUpcomingAppointments() {
      return apiCall('/appointments?limit=5').then(function(data) {
        var container = document.getElementById('appointmentsList');
        if (data.appointments && data.appointments.length > 0) {
          container.innerHTML = data.appointments.map(function(apt) {
            var d = new Date(apt.date);
            var dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            return '<div class="appointment-item"><div class="appointment-info"><p class="doctor-name">' + apt.doctor.name + '</p><span class="appointment-time">' + dateStr + ' • ' + apt.time + '</span></div><div class="appointment-actions"><span class="appointment-badge ' + (apt.status === 'confirmed' ? 'confirmed' : 'pending') + '">' + apt.status + '</span><button class="view-btn">View</button></div>';
          }).join('');
        } else { container.innerHTML = '<div class="empty">No upcoming appointments</div>'; }
      }).catch(function() {
        document.getElementById('appointmentsList').innerHTML = '<div class="appointment-item"><div class="appointment-info"><p class="doctor-name">Dr. Johnson</p><span class="appointment-time">Tomorrow • 10:30 AM</span></div><div class="appointment-actions"><span class="appointment-badge confirmed">Confirmed</span><button class="view-btn">View</button></div>';
      });
    }
    
    function loadAppointments() {
      return apiCall('/appointments?limit=20').then(function(data) {
        var container = document.getElementById('appointmentsContent');
        if (data.appointments && data.appointments.length > 0) {
          var html = '<table class="data-table"><thead><tr><th>Date</th><th>Time</th><th>Doctor</th><th>Reason</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
          html += data.appointments.map(function(apt) {
            var d = new Date(apt.date);
            var dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            var statusClass = apt.status === 'confirmed' ? 'status-confirmed' : apt.status === 'cancelled' ? 'status-cancelled' : 'status-pending';
            return '<tr><td>' + dateStr + '</td><td>' + apt.time + '</td><td>' + apt.doctor.name + '</td><td>' + (apt.reason || '-') + '</td><td><span class="status-badge ' + statusClass + '">' + apt.status + '</span></td><td>' + (apt.status !== 'cancelled' && apt.status !== 'completed' ? '<button class="btn-small">Cancel</button>' : '-') + '</td></tr>';
          }).join('');
          html += '</tbody></table>';
          container.innerHTML = html;
        } else { container.innerHTML = '<div class="empty">No appointments found</div>'; }
      }).catch(function() {
        document.getElementById('appointmentsContent').innerHTML = '<div class="error">Failed to load appointments</div>';
      });
    }
    
    function loadMedications() {
      return apiCall('/medications?limit=20').then(function(data) {
        var container = document.getElementById('medicationsContent');
        if (data.medications && data.medications.length > 0) {
          var html = '<table class="data-table"><thead><tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Prescribed By</th><th>Status</th><th>Refills</th></tr></thead><tbody>';
          html += data.medications.map(function(med) {
            var statusClass = med.status === 'active' ? 'status-active' : 'status-stopped';
            return '<tr><td><strong>' + med.medicationName + '</strong></td><td>' + med.dosage + '</td><td>' + med.frequency + '</td><td>' + med.doctor.name + '</td><td><span class="status-badge ' + statusClass + '">' + med.status + '</span></td><td>' + med.refillsRemaining + '</td></tr>';
          }).join('');
          html += '</tbody></table>';
          container.innerHTML = html;
        } else { container.innerHTML = '<div class="empty">No medications found</div>'; }
      }).catch(function() {
        document.getElementById('medicationsContent').innerHTML = '<div class="error">Failed to load medications</div>';
      });
    }
    
    function loadRecords() {
      return apiCall('/results?limit=20').then(function(data) {
        var container = document.getElementById('recordsContent');
        if (data.results && data.results.length > 0) {
          var html = '<table class="data-table"><thead><tr><th>Test Name</th><th>Type</th><th>Date</th><th>Doctor</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
          html += data.results.map(function(r) {
            var d = new Date(r.resultDate);
            var dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            var statusClass = r.status === 'completed' ? 'status-completed' : 'status-pending';
            return '<tr><td><strong>' + r.testName + '</strong></td><td>' + (r.testType || '-') + '</td><td>' + dateStr + '</td><td>' + r.doctor.name + '</td><td><span class="status-badge ' + statusClass + '">' + r.status + '</span></td><td><button class="btn-small">View</button></td></tr>';
          }).join('');
          html += '</tbody></table>';
          container.innerHTML = html;
        } else { container.innerHTML = '<div class="empty">No medical records found</div>'; }
      }).catch(function() {
        document.getElementById('recordsContent').innerHTML = '<div class="error">Failed to load records</div>';
      });
    }
    
    function loadVitals() {
      return apiCall('/health-summary/history/vitals?limit=10').then(function(data) {
        var container = document.getElementById('vitalsContent');
        if (data.vitals && data.vitals.length > 0) {
          var html = '<table class="data-table"><thead><tr><th>Date</th><th>Heart Rate</th><th>Blood Pressure</th><th>Weight</th><th>Temperature</th><th>SpO2</th></tr></thead><tbody>';
          html += data.vitals.map(function(v) {
            var vitals = JSON.parse(v.vitalSigns);
            var d = new Date(v.recordedAt);
            var dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            return '<tr><td>' + dateStr + '</td><td>' + (vitals.heartRate || '-') + ' BPM</td><td>' + (vitals.bloodPressure || '-') + '</td><td>' + (vitals.weight || '-') + ' kg</td><td>' + (vitals.temperature || '-') + '°F</td><td>' + (vitals.oxygen || '-') + '%</td></tr>';
          }).join('');
          html += '</tbody></table>';
          container.innerHTML = html;
        } else { container.innerHTML = '<div class="empty">No vitals history found</div>'; }
      }).catch(function() {
        document.getElementById('vitalsContent').innerHTML = '<div class="error">Failed to load vitals</div>';
      });
    }
    
